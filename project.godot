; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chronicle of Two"
config/description="A private two-player action RPG: Ember Storybook, host-authoritative co-op."
config/version="0.1.0-m1"
run/main_scene="res://game/scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"
GameData="*res://game/data/game_data.gd"
Settings="*res://game/autoload/settings.gd"
Net="*res://game/net/net_session.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Heroes"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Props"

[netfox]

general/clear_settings=false
time/tickrate=60
time/max_ticks_per_frame=8
time/sync_to_physics=false
time/suppress_offline_peer_warning=true
rollback/enabled=true
rollback/history_limit=64
rollback/input_redundancy=4
rollback/display_offset=0
rollback/input_delay=0
rollback/enable_diff_states=true
events/enabled=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.055, 0.07, 1)
